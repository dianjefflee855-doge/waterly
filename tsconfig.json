{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "types": ["node"],
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src", "declaration": false, "sourceMap": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/renderer/**"]
}
